# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings > API in the Supabase dashboard) to switch Daybook from
# local-only storage to a real hosted account with sign-in.
#
# Leave .env.local absent (or these two blank) to keep using local-only
# storage — nothing else changes.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
